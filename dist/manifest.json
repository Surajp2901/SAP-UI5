{
	"sap.app": {
		"id": "so.app",
		"type": "application",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"crossNavigation": {
			"inbounds": {
				"show-products": {
					"semanticObject": "Products",
					"action": "manage",
					"title": "Browse Products",
					"subTitle": "Manage products from S4HANA",
					"icon": "sap-icon://product"
				}
			}
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"i18n": "i18n/i18n.properties",
		"dataSources": {
			"Products": {
				"uri": "/sap/opu/odata/sap/API_PRODUCT_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0"
				}
			}
		}
	},
	"sap.ui": {},
	"sap.ui5": {
		"rootView": {
			"id": "appid",
			"viewName": "so.app.view.app",
			"type": "XML"
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewPath": "so.app.view",
				"viewType": "XML",
				"controlId": "layout",
				"async": true,
				"clearControlAggregation": true
			},
			"routes": [
				{
					"name": "myRoutes1",
					"pattern": "",
					"target": [
						"products",
						"default"
					]
				},
				{
					"name": "myRoutes3",
					"pattern": "create",
					"target": [
						"products",
						"create"
					]
				},
				{
					"name": "myRoutes4",
					"pattern": "edit/{id}",
					"target": [
						"products",
						"edit"
					]
				},
				{
					"name": "myRoutes2",
					"pattern": "display/{id}",
					"target": [
						"products",
						"details"
					]
				}
			],
			"targets": {
				"default": {
					"viewName": "default",
					"viewId": "defaultid",
					"controlAggregation": "midColumnPages"
				},
				"products": {
					"viewName": "master",
					"viewId": "products",
					"controlAggregation": "beginColumnPages"
				},
				"details": {
					"viewName": "detail",
					"viewId": "details",
					"controlAggregation": "midColumnPages"
				},
				"create": {
					"viewName": "create",
					"viewId": "create",
					"controlAggregation": "midColumnPages"
				},
				"edit": {
					"viewName": "edit",
					"viewId": "edit",
					"controlAggregation": "midColumnPages"
				}
			}
		},
		"models": {
			"": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"dataSource": "Products",
				"settings": {
					"defaultBindingMode": "TwoWay"
				}
			},
			"local": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/mockdata/Create.json",
				"preload": "true"
			},
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleUrl": "i18n/i18n.properties"
				}
			}
		},
		"flexBundle": false
	},
	"sap.cloud": {
		"public": true,
		"service": "soapp"
	}
}